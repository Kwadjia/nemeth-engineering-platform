# Copy to .env for local development. Docker Compose reads this file too.

# --- PostgreSQL (docker compose `db` service) ----------------------------------
POSTGRES_USER=nemeth
POSTGRES_PASSWORD=nemeth
POSTGRES_DB=nemeth
POSTGRES_PORT=5432

# --- API (apps/api) -------------------------------------------------------------
NEMETH_ENVIRONMENT=development
NEMETH_DEBUG=false
NEMETH_LOG_LEVEL=INFO
NEMETH_LOG_FORMAT=console            # console | json
NEMETH_DATABASE_URL=postgresql+psycopg://nemeth:nemeth@localhost:5432/nemeth
NEMETH_TEST_DATABASE_URL=postgresql+psycopg://nemeth:nemeth@localhost:5432/nemeth_test
NEMETH_CORS_ORIGINS=["http://localhost:5173"]
NEMETH_STORAGE_BACKEND=local
# NEMETH_STORAGE_ROOT defaults to <repo>/storage
NEMETH_ACTOR_ID=arthur
NEMETH_ACTOR_NAME=Arthur Nemeth

# --- Web (apps/web) -------------------------------------------------------------
# Vite proxies /api to this target during development.
VITE_API_PROXY_TARGET=http://localhost:8000
